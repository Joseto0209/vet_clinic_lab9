<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Veterinarians Directory</h1>
  <% if policy(Vet).new? %>
    <%= link_to "New Veterinarian", new_vet_path, class: "btn btn-primary" %>
  <% end %>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Full Name</th>
          <th>Email</th>
          <th>Specialization</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @vets.each do |vet| %>
          <tr>
            <td>
              <% if policy(vet).show? %>
                <%= link_to "#{vet.first_name} #{vet.last_name}", vet_path(vet), class: "text-decoration-none fw-bold text-info" %>
              <% else %>
                <%= "#{vet.first_name} #{vet.last_name}" %>
              <% end %>
            </td>
            <td><%= vet.email %></td>
            <td><span class="badge bg-info text-dark"><%= vet.specialization %></span></td>
            <td>
              <% if policy(vet).edit? %>
                <%= link_to "Edit", edit_vet_path(vet), class: "btn btn-sm btn-outline-warning me-1" %>
              <% end %>
              <% if policy(vet).destroy? %>
                <%= button_to "Delete", vet_path(vet), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>